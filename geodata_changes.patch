+services:
+  geodata-inspector:
+    build: .
+    ports:
+      - "5050:5050"
+    volumes:
+      # Persist uploaded files across restarts (optional)
+      - geodata_uploads:/tmp/geodata_uploads
+      # Mount config so you can edit language/country without rebuilding
+      - ./web_app/config.yaml:/app/web_app/config.yaml
+    environment:
+      - PYTHONUNBUFFERED=1
+      - HOST=0.0.0.0
+    restart: unless-stopped
+
+volumes:
+  geodata_uploads:
